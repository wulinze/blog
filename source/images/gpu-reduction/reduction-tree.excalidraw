      "link": null,
      "locked": false,
      "text": "蓝色 = 当前值；绿色 = 合并结果。8 个数仍需 7 次有用加法，树的深度是 3。",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "蓝色 = 当前值；绿色 = 合并结果。8 个数仍需 7 次有用加法，树的深度是 3。",
      "autoResize": true,
      "lineHeight": 1.35
    },
