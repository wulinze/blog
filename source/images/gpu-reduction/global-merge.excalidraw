      "seed": 1669026153,
      "version": 2,
      "versionNonce": 751718345,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793607758433,
      "link": null,
      "locked": false,
      "text": "固定树减少了来自 block 完成顺序的变化，但不保证跨编译器/架构的逐 bit 一致。",
      "fontSize": 23,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "固定树减少了来自 block 完成顺序的变化，但不保证跨编译器/架构的逐 bit 一致。",
      "autoResize": true,
      "lineHeight": 1.35
    },
