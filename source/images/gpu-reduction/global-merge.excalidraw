      "index": "a2",
      "roundness": null,
      "seed": 2146068681,
      "version": 2,
      "versionNonce": 134400809,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793607758433,
      "link": null,
      "locked": false,
      "text": "对照的是完整工作流程；不能漏掉清零、临时结果或最后一层的成本。",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "对照的是完整工作流程；不能漏掉清零、临时结果或最后一层的成本。",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "e4",
