    },
    {
      "id": "e3",
      "type": "text",
      "x": 34,
      "y": 78,
      "width": 661.4159545898438,
      "height": 28.35,
      "angle": 0,
      "strokeColor": "#667286",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1.25,
      "opacity": 100,
      "groupIds": [],
