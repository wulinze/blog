      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C01 = A00 @ B01 + A01 @ B11     （@ 表示矩阵乘法）",
      "originalText": "C01 = A00 @ B01 + A01 @ B11     （@ 表示矩阵乘法）",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.4
    },
    {
      "id": "shape-79",
      "type": "text",
      "x": 48,
      "y": 935,
      "width": 618.7,
      "height": 32.199999999999996,
      "angle": 0,
      "strokeColor": "#243247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 625601,
      "version": 1,
      "versionNonce": 8273591,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "为什么这样取？C 的行决定 A 的行；C 的列决定 B 的列。",
      "originalText": "为什么这样取？C 的行决定 A 的行；C 的列决定 B 的列。",
