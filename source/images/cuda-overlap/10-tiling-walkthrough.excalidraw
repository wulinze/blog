      "verticalAlign": "top",
      "containerId": null,
      "originalText": "block=(1,0) → C 的右上 2×2 块；thread=(0,1) → C[1,2]\nrow = block.y×2 + thread.y = 1；col = block.x×2 + thread.x = 2",
      "autoResize": true,
      "lineHeight": 1.35
