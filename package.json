{
  "name": "wulinze-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "hexo server --ip 127.0.0.1 --draft",
    "draft": "hexo new draft",
    "post": "hexo new post",
    "ready": "hexo publish",
    "verify": "npm run check && npm test && npm run build && npm run check:site",
    "sync": "node tools/sync.mjs",
    "publish": "npm run verify && node tools/sync.mjs --deploy",
    "build": "hexo clean && hexo generate --bail",
    "clean": "hexo clean",
    "deploy": "npm run check && npm run build && npm run check:site && node tools/publish.mjs",
    "server": "hexo server",
    "check": "node tools/check-content.mjs",
    "check:site": "node tools/check-site.mjs",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.mjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@vscode/markdown-it-katex": "1.1.2",
    "hexo": "8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-next": "8.29.1",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
